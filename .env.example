# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — never commit secrets.

# --- OpenAI (optional, for LLM experiments) ---
# Required when LLM_BACKEND=openai or when running ./pipeline_run.sh full / llm-only
OPENAI_API_KEY=

# OpenAI chat model (default: gpt-3.5-turbo)
OPENAI_MODEL=gpt-3.5-turbo

# --- LLM experiment settings ---
# Backend: auto | openai | local
#   auto   — use OpenAI if OPENAI_API_KEY is set, otherwise local HuggingFace model
#   openai — force OpenAI API
#   local  — force local HuggingFace model (no API key needed)
LLM_BACKEND=auto

# HuggingFace model used when LLM_BACKEND=local
LLM_LOCAL_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Prompt strategy: basic | few_shot | both
LLM_PROMPT=basic

# Limit LLM test samples per dataset (leave empty for full test set)
# LLM_MAX_SAMPLES=50

# --- HuggingFace (optional) ---
# Token for gated models or higher rate limits
# HF_TOKEN=

# --- Hardware (optional) ---
# GPU device IDs, e.g. "0" or "0,1". Use "-1" to force CPU.
# CUDA_VISIBLE_DEVICES=0
